---
import GitHubCat from "@/components/svg/GitHubCat.vue";
import LinkedInSquare from "@/components/svg/LinkedInSquare.vue";
import avatar from "@/images/avatar037.png";
import { Image } from "astro:assets";
---

<header
  class="sticky top-0 z-10 mx-auto mb-2 w-full max-w-160 bg-gray-950/50 px-6 py-4 font-semibold text-white backdrop-blur-sm"
>
  <nav class="relative flex items-center justify-between gap-10">
    <a
      class="absolute -top-6 flex h-8 items-center rounded-full bg-pink-300 px-3 text-pink-900 underline opacity-0 transition-[opacity_top] duration-200 focus:top-0 focus:opacity-100 focus-visible:top-0 focus-visible:opacity-100"
      href="#main-content">Skip to content</a
    >
    <a
      class="group flex items-center gap-3 rounded-full bg-gray-950/80 pr-4"
      href="/"
      aria-label="Home"
    >
      <Image
        class="rounded-full bg-pink-500 text-transparent"
        src={avatar}
        alt="Picture of a red racecar called 'il monster' from the game 'art of rally'"
        width={32}
        height={32}
        densities={[1.5, 2, 3]}
        priority
      />
      <span
        class="text-lg text-pink-300 underline decoration-transparent underline-offset-2 transition-['text-decoration-color'] group-hover:decoration-[currentColor] group-focus-visible:decoration-[currentColor] active:decoration-[currentColor]"
        >Home</span
      >
    </a>
    <ul class="flex list-none gap-4">
      <li>
        <a
          class="flex min-h-6 items-center gap-2 underline decoration-transparent underline-offset-2 transition-['text-decoration-color'] hover:decoration-[currentColor] focus-visible:decoration-[currentColor] active:decoration-[currentColor]"
          href="https://www.linkedin.com/in/joost-kersjes/"
          target="_blank"
          ><LinkedInSquare
            class="size-4.5 fill-white"
            aria-hidden="true"
          /><span class="sr-only sm:not-sr-only">LinkedIn</span></a
        >
      </li>
      <li>
        <a
          class="flex min-h-6 items-center gap-2 underline decoration-transparent underline-offset-2 transition-['text-decoration-color'] hover:decoration-[currentColor] focus-visible:decoration-[currentColor] active:decoration-[currentColor]"
          href="https://github.com/JoostKersjes/kersjes.dev"
          target="_blank"
          ><GitHubCat class="size-4.5 fill-white" aria-hidden="true" /><span
            class="sr-only sm:not-sr-only">GitHub</span
          ></a
        >
      </li>
      <li>
        <a class="group flex gap-2 text-pink-300 sm:ml-2" href="/pizza/"
          ><span role="img" aria-label="Pizza">🍕</span><span
            class="underline decoration-transparent underline-offset-2 transition-['text-decoration-color'] group-hover:decoration-[currentColor] group-focus-visible:decoration-[currentColor] group-active:decoration-[currentColor]"
            >Recipe</span
          ></a
        >
      </li>
    </ul>
  </nav>
</header>
